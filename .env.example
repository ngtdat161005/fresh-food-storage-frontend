# Sao chép thành .env.local rồi chỉnh theo máy của bạn. Không đặt token hay khóa Adafruit vào biến VITE_.
# Địa chỉ backend, gồm cả tiền tố /api.
VITE_API_BASE_URL=http://localhost:8000/api
# TẠM THỜI đến khi backend có đăng nhập: mã người dùng (bảng NguoiDung) gửi kèm mỗi yêu cầu.
VITE_DEV_USER_ID=1
# WebSocket theo phòng; {room_id} được thay bằng mã phòng đang xem. Để trống thì hỏi lại mỗi 60 giây.
VITE_WS_URL=ws://localhost:8000/api/ws/storage-rooms/{room_id}
